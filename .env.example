# AWS (required for step2_ingest_aws.py)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
BASE_S3_PATH=s3://arn:aws:s3:<region>:<account-id>:accesspoint/<accesspoint-name>/mimiciv/3.1/

# Volume paths — ${HOME} expands automatically to your home directory (no need to edit)
MIMICIV_DATA_PATH=${HOME}/mimic/mimiciv_data
ATHENA_VOCAB_PATH=${HOME}/mimic/athena_vocab
DUCKDB_PATH=${HOME}/mimic/mimiciv_duckdb

# Paths
LOCAL_DOWNLOAD_DIR=/data

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
